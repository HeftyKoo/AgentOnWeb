{
  "name": "@agentonweb/dsh-surface",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "DSH On Web: the native DeepSeek Harness integration for AgentOnWeb.",
  "repository": { "type": "git", "url": "git+https://github.com/HeftyKoo/AgentOnWeb.git" },
  "bugs": { "url": "https://github.com/HeftyKoo/AgentOnWeb/issues" },
  "homepage": "https://github.com/HeftyKoo/AgentOnWeb#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "scripts": {
    "build": "node ../../scripts/build-dsh-plugin.mjs",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "lib/index.js",
    "lib/host.js",
    "lib/client.js"
  ],
  "publishConfig": { "access": "public" },
  "agentonweb": {
    "dsh": "0.1.2-alpha.3",
    "connectorProtocol": 1
  },
  "devDependencies": {
    "@agentonweb/connector-contract": "workspace:*",
    "@agentonweb/connector-host": "workspace:*"
  }
}
