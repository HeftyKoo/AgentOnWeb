# Generated browser-extension preview
apps/extension/preview/preview.js
apps/extension/preview/preview.js.map

# Local runtime and environment state
.env
.env.*
!.env.example
!.env.*.example
.agentonweb/
.cache/
.turbo/

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Extension packaging output and private keys
*.crx
*.pem
*.p8
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
*.xcarchive/
*.xcresult/
