{
  "name": "overcode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:extension": "node scripts/build-extension.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev:bridge": "pnpm --filter @overcode/local-bridge dev",
    "install:dsh-surface": "node scripts/install-dsh-surface.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
